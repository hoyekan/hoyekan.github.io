Notebook[{

Cell[CellGroupData[{
Cell["\<\
Modeling Groundwater Flow Around Wells with Discharge Potential : Analytical \
Approaches for 1D Confined/Unconfined Aquifers and 2D Flow.\
\>", "Title",
 CellChangeTimes->{{3.954984992179613*^9, 3.9549850042823033`*^9}, {
  3.9550385569062443`*^9, 3.9550385982337985`*^9}},
 FontSize->23,
 FontWeight->"Bold",
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"ebe5247e-df80-41a5-919d-d7ba710e16e9"],

Cell[BoxData[
 RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.95413939991811*^9, 3.9541394054295635`*^9}, {
   3.9553566560898733`*^9, 3.9553566570583324`*^9}, 3.955375264815172*^9},
 CellLabel->"In[1]:=",ExpressionUUID->"b86e5ac1-5498-4f94-a338-5e4450f208b6"],

Cell[TextData[{
 "The ",
 StyleBox["discharge potential",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 ", \[CapitalPhi], is a scalar function that simplifies the governing \
equations of groundwater flow by satisfying Laplace' s equation, enabling the \
use of potential flow theory and the principle of superposition .\n\n",
 StyleBox["Darcy\[CloseCurlyQuote]s Law",
  FontWeight->"Bold"],
 " (for homogeneous, isotropic media) is given as:\n\n",
 StyleBox["\t\t\t\t\t\t",
  FontSize->20],
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "x"], TraditionalForm]],
  FontSize->20,ExpressionUUID->"1ed95a60-23f4-4ca0-ac51-f728c70f04f8"],
 StyleBox[" = - k ",
  FontSize->20,
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[PartialD]", "h"}], 
    RowBox[{"\[PartialD]", "x"}]], TraditionalForm]],
  FontSize->20,ExpressionUUID->"845d65e1-20ab-4332-a9ab-5f30d36efc92"],
 StyleBox[" ,     ",
  FontSize->20,
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "y"], TraditionalForm]],
  FontSize->20,ExpressionUUID->"cad305e6-6ad0-4e38-94cb-cec61f3e253a"],
 StyleBox[" = - k ",
  FontSize->20,
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[PartialD]", "h"}], 
    RowBox[{"\[PartialD]", "y"}]], TraditionalForm]],
  FontSize->20,ExpressionUUID->"9d72fcbe-f661-4891-b4b6-76333fd1751c"],
 StyleBox[",     ",
  FontSize->20,
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "z"], TraditionalForm]],
  FontSize->20,ExpressionUUID->"7d6d8f79-44d0-4f70-9ee6-69b964c49feb"],
 StyleBox[" = - k ",
  FontSize->20,
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[PartialD]", "h"}], 
    RowBox[{"\[PartialD]", "z"}]], TraditionalForm]],
  FontSize->20,ExpressionUUID->"df29de21-aa8f-4ec5-a2ed-75ee1ec61076"],
 StyleBox["\n",
  FontSize->20],
 "\nThe ",
 StyleBox["continuity equation for steady-state flow",
  FontWeight->"Bold"],
 " in a homogeneous and isotropic medium is: (",
 StyleBox["assuming Dupuit-Forchheimer approximation, ignoring vertical flow",
  FontWeight->"Bold"],
 "):\n",
 StyleBox["\t\t\t\t\t\t\t\t     ",
  FontSize->20],
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[PartialD]", 
     SubscriptBox["q", "x"]}], 
    RowBox[{"\[PartialD]", "x"}]], TraditionalForm]],
  FontSize->20,ExpressionUUID->"92e96ade-ff21-4e48-850a-b99aa7a03b85"],
 StyleBox[" + ",
  FontSize->20,
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[PartialD]", 
     SubscriptBox["q", "y"]}], 
    RowBox[{"\[PartialD]", "y"}]], TraditionalForm]],
  FontSize->20,ExpressionUUID->"48f1d8c5-c19d-49f9-9130-18ac81b0ec0d"],
 StyleBox[" = 0 ",
  FontSize->20,
  FontWeight->"Bold"],
 StyleBox["\n",
  FontSize->20],
 "\nCombining with ",
 StyleBox["Darcy\[CloseCurlyQuote]s Law",
  FontWeight->"Bold"],
 " yields ",
 StyleBox["Laplace\[CloseCurlyQuote]s equation for head:\n\t\t\t\t\t\t\t\t\t\t\
\t",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     SuperscriptBox["\[PartialD]", "2"], "h"}], 
    RowBox[{"\[PartialD]", 
     SuperscriptBox["x", "2"]}]], TraditionalForm]],
  FontSize->20,ExpressionUUID->"a0d3350a-b075-4033-9d16-01b6d3c8d84f"],
 StyleBox[" + ",
  FontSize->20,
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     SuperscriptBox["\[PartialD]", "2"], "h"}], 
    RowBox[{"\[PartialD]", 
     SuperscriptBox["y", "2"]}]], TraditionalForm]],
  FontSize->20,ExpressionUUID->"19e2f214-d580-4ff6-ac1f-db480d842b23"],
 StyleBox[" = 0 ",
  FontSize->20,
  FontWeight->"Bold"],
 StyleBox["\t\t\t\t",
  FontWeight->"Bold"],
 "\n\n",
 StyleBox["Discharge Potential",
  FontSize->18,
  FontWeight->"Bold"],
 StyleBox["\n",
  FontSize->18],
 StyleBox["The discharge potential \[CapitalPhi](x,y) is introduced to \
simplify the governing equations. ",
  FontSize->15],
 StyleBox["For a confined aquifer",
  FontSize->15,
  FontWeight->"Bold"],
 StyleBox[", the discharge potential is defined as: ",
  FontSize->15],
 StyleBox["\[CapitalPhi] = K b h. ",
  FontSize->15,
  FontWeight->"Bold"],
 StyleBox["So the discharge vector components in this case are given as:\n\n\t\
\t\t\t\t\t",
  FontSize->15],
 StyleBox["\t\t             \t      ",
  FontSize->17],
 Cell[BoxData[
  FormBox[
   SubscriptBox["Q", "x"], TraditionalForm]],
  FontSize->17,ExpressionUUID->"6fd021e8-79be-4f96-9736-363296e4f06e"],
 StyleBox[" = -",
  FontSize->17,
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[PartialD]", 
     StyleBox["\[CapitalPhi]",
      FontSize->15,
      FontWeight->"Bold"]}], 
    RowBox[{"\[PartialD]", "x"}]], TraditionalForm]],
  FontSize->17,ExpressionUUID->"9b0d8210-16b8-48be-bb40-db7d24743348"],
 StyleBox[" ,     ",
  FontSize->17,
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["Q", "y"], TraditionalForm]],
  FontSize->17,ExpressionUUID->"1cb8ec74-0f50-4065-adba-544579b9cd70"],
 StyleBox[" = -",
  FontSize->17,
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[PartialD]", 
     StyleBox["\[CapitalPhi]",
      FontSize->15,
      FontWeight->"Bold"]}], 
    RowBox[{"\[PartialD]", "y"}]], TraditionalForm]],
  FontSize->17,ExpressionUUID->"d4a16f6b-6a9c-427d-81f0-ce4b75c7bf19"],
 StyleBox["\n\n",
  FontSize->12],
 StyleBox["Substituting these into the continuity equation yields Laplace\
\[CloseCurlyQuote]s equation for the discharge potential:\n\n\t\t\t\t\t\t\t\t\
\t\t\t\t",
  FontSize->15],
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     SuperscriptBox["\[PartialD]", "2"], 
     StyleBox["\[CapitalPhi]",
      FontSize->15,
      FontWeight->"Bold"]}], 
    RowBox[{"\[PartialD]", 
     SuperscriptBox["x", "2"]}]], TraditionalForm]],
  FontSize->20,ExpressionUUID->"78e3acc3-4805-4940-85a7-8887b5c0d493"],
 StyleBox[" + ",
  FontSize->20,
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     SuperscriptBox["\[PartialD]", "2"], 
     StyleBox["\[CapitalPhi]",
      FontSize->15,
      FontWeight->"Bold"]}], 
    RowBox[{"\[PartialD]", 
     SuperscriptBox["y", "2"]}]], TraditionalForm]],
  FontSize->20,ExpressionUUID->"5830076e-2de5-474b-b4d8-22987c9ec823"],
 StyleBox["\n\t\t\t\t\t\t\t\t\t\t\t\t\t\nThe discharge potential for an \
unconfined aquifer is defined as:   ",
  FontSize->15],
 StyleBox["\[CapitalPhi] = ",
  FontSize->15,
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], " "}], TraditionalForm]],
  FontWeight->"Bold",ExpressionUUID->"54b0ee99-722e-46e1-8bd7-0a4f111e55ba"],
 StyleBox["K ",
  FontSize->15,
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["h", "2"], TraditionalForm]],
  FontWeight->"Bold",ExpressionUUID->"0b92b238-9e4f-40a3-949f-6ac517410298"],
 StyleBox[" ",
  FontSize->15,
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.955038619837629*^9, 3.955038656701845*^9}, {
  3.9550387808279495`*^9, 3.9550387841681876`*^9}, {3.955039074973029*^9, 
  3.955039218166174*^9}, {3.9550392618677387`*^9, 3.955039312176056*^9}, {
  3.955039344264206*^9, 3.955039403511348*^9}, {3.95503943961855*^9, 
  3.95503952001932*^9}, {3.955039812533947*^9, 3.9550398199583054`*^9}, {
  3.955039864067048*^9, 3.9550399051334643`*^9}, {3.9550399533891697`*^9, 
  3.9550400919757137`*^9}, {3.955040139355788*^9, 3.955040149964451*^9}, {
  3.95504021716356*^9, 3.9550402902987137`*^9}, {3.955040322105733*^9, 
  3.955040362958254*^9}, {3.9550404028540707`*^9, 3.9550404084116306`*^9}, {
  3.955040443162917*^9, 3.9550405202537217`*^9}, {3.9551867815811644`*^9, 
  3.9551867830050917`*^9}},ExpressionUUID->"4bc0433c-170b-444a-a6af-\
6a583b3196c0"],

Cell[CellGroupData[{

Cell["\<\
1 D Groundwater Flow Using Discharge Potential (\[CapitalPhi]) - Combined \
confined and unconfined flow.\
\>", "Subsection",
 CellChangeTimes->{{3.954139483113933*^9, 3.954139491694036*^9}, {
  3.9542291854780807`*^9, 3.954229225182551*^9}, {3.9542294480210037`*^9, 
  3.9542294609094887`*^9}, {3.955081220248413*^9, 3.9550812330552907`*^9}, {
  3.9551684751372266`*^9, 3.955168481896378*^9}},
 FontWeight->"Bold",ExpressionUUID->"0905d7bb-cbde-4b9f-997c-5e158c126588"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Parameters", " ", "Definition"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"L", "=", "500"}], ";"}], "     ", 
   RowBox[{"(*", 
    RowBox[{"Aquifer", " ", "length", " ", 
     RowBox[{"(", "m", ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"b", "=", "20"}], ";"}], "       ", 
   RowBox[{"(*", 
    RowBox[{"Aquifer", " ", "thickness", " ", 
     RowBox[{"(", "m", ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"K", "=", "0.001"}], ";"}], 
   RowBox[{"(*", 
    RowBox[{"Hydraulic", " ", "conductivity", " ", 
     RowBox[{"(", 
      RowBox[{"m", "/", "s"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"h0", "=", "30"}], ";"}], "    ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Head", " ", "at", " ", "x"}], "=", 
     RowBox[{"0", " ", 
      RowBox[{"(", "m", ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"hL", "=", "5"}], ";"}], "      ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Head", " ", "at", " ", "x"}], "=", 
     RowBox[{"L", " ", 
      RowBox[{"(", "m", ")"}]}]}], "*)"}], "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.954139394837621*^9, 3.954139394839616*^9}, {
  3.9541637054829884`*^9, 3.954163728390111*^9}, {3.954163794728671*^9, 
  3.954163852105962*^9}, {3.954227921884096*^9, 3.9542280066879663`*^9}, {
  3.954228176362651*^9, 3.9542281836630793`*^9}, {3.9542284198943634`*^9, 
  3.954228514295948*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"6b9a3535-74c5-4307-8fd8-9427bda544a3"],

Cell[CellGroupData[{

Cell["Solve for the Discharge Potential", "Subsubsection",
 CellChangeTimes->{{3.9542283092333903`*^9, 3.9542283314870834`*^9}},
 FontSize->15,
 FontWeight->"Bold",ExpressionUUID->"0fa4618c-e3fa-4970-b640-4271856a9733"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Discharge", " ", "potential", " ", "definitions"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"PhiConfined", "[", "h_", "]"}], ":=", 
     RowBox[{
      RowBox[{"K", " ", "b", " ", "h"}], "-", 
      RowBox[{"0.5", " ", "K", " ", 
       SuperscriptBox["b", "2"]}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Confined", " ", "region"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"PhiUnconfined", "[", "h_", "]"}], ":=", 
     RowBox[{"0.5", " ", "K", " ", 
      SuperscriptBox["h", "2"]}]}], ";"}], "        ", 
   RowBox[{"(*", 
    RowBox[{"Unconfined", " ", "region"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"PhiInterface", "=", 
     RowBox[{"0.5", " ", "K", " ", 
      SuperscriptBox["b", "2"]}]}], ";"}], "                      ", 
   RowBox[{"(*", 
    RowBox[{
    "Discharge", " ", "potential", " ", "at", " ", "the", " ", "interface"}], 
    "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Boundary", " ", "conditions", " ", "for", " ", "Phi"}], "*)"}], 
   RowBox[{"(*", 
    RowBox[{
    "Phi", " ", "is", " ", "the", " ", "discharge", " ", "potential"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Phi0", "=", 
     RowBox[{"PhiConfined", "[", "h0", "]"}]}], ";"}], "                   ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Phi", " ", "at", " ", "x"}], "=", "0"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"PhiL", "=", 
     RowBox[{"PhiUnconfined", "[", "hL", "]"}]}], ";"}], "               ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Phi", " ", "at", " ", "x"}], "=", "L"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Linear", " ", "potential", " ", "solution", " ", "for", " ", "Phi", 
     RowBox[{"(", "x", ")"}]}], "*)"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Interface", " ", "potential", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"where", " ", "h"}], "=", "b"}], ")"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Phi", "[", "x_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{"(", 
         RowBox[{"PhiL", "-", "Phi0"}], ")"}], "L"], " ", "x"}], " ", "+", 
      "Phi0"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Find", " ", "the", " ", "interface", " ", "location", " ", "where", " ",
       "h", 
      RowBox[{"(", "x", ")"}]}], "=", "b"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"xInterface", "=", 
     RowBox[{"x", "/.", " ", 
      RowBox[{
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Phi", "[", "x", "]"}], "\[Equal]", "PhiInterface"}], ",", 
         "x"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9542284770211353`*^9, 3.9542284796889167`*^9}, {
  3.9547435086615686`*^9, 3.9547435233976517`*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"8b70fec8-5e79-440d-9563-34b00e9408c9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Compute the Head Distribution", "Subsubsection",
 CellChangeTimes->{{3.9542281271629295`*^9, 3.954228135631735*^9}},
 FontSize->15,
 FontWeight->"Bold",ExpressionUUID->"4009ff23-d8db-4238-894f-e8196f10eea2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"h", "[", "x_", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"x", "\[LessEqual]", "xInterface"}], ",", "\[IndentingNewLine]", 
     FractionBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Phi", "[", "x", "]"}], "+", 
        RowBox[{"0.5", " ", "K", " ", 
         SuperscriptBox["b", "2"]}]}], ")"}], 
      RowBox[{"K", " ", "b"}]], ",", 
     RowBox[{"(*", 
      RowBox[{"Confined", " ", "solution"}], "*)"}], "\[IndentingNewLine]", 
     SqrtBox[
      FractionBox[
       RowBox[{"2", " ", 
        RowBox[{"Phi", "[", "x", "]"}]}], "K"]]}], "                  ", 
    RowBox[{"(*", 
     RowBox[{"Unconfined", " ", "solution"}], "*)"}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.954139423850012*^9, 3.9541394238519406`*^9}, {
  3.9541641417642403`*^9, 3.95416425542297*^9}, {3.9542286351426644`*^9, 
  3.9542286658443465`*^9}, {3.9549829142086368`*^9, 3.954982915051137*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"e8021856-b907-4c9c-aa6f-f0eaeba459eb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Show", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"h", "[", "x", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"PlotStyle", "\[Rule]", "Thick"}], ",", "\[IndentingNewLine]", 
      RowBox[{"PlotRange", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "L"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "35"}], "}"}]}], "}"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Frame", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
      RowBox[{"FrameLabel", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"\"\<Distance (m)\>\"", ",", "\"\<Head (m)\>\""}], "}"}]}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{"PlotLabel", "\[Rule]", 
       RowBox[{"Style", "[", 
        RowBox[{
        "\"\<Head Distribution from Confined to Unconfined Flow\>\"", ",", 
         "12", ",", "Bold"}], "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"Epilog", "\[Rule]", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Grid", " ", "line", " ", "at", " ", "xInterface"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Dashed", ",", "Gray", ",", 
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"xInterface", ",", "0"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"xInterface", ",", "35"}], "}"}]}], "}"}], "]"}]}], 
          "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"Grid", " ", "line", " ", "at", " ", "head", " ", "b"}], 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"Dashed", ",", "Gray", ",", 
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", "b"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"L", ",", "b"}], "}"}]}], "}"}], "]"}]}], "}"}], ",", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"Labels", " ", "and", " ", "point"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<Confined Flow\>\"", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"xInterface", "/", "2"}], ",", "25"}], "}"}]}], "]"}], 
         ",", "\[IndentingNewLine]", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<Unconfined Flow\>\"", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"xInterface", "+", "100"}], ",", "10"}], "}"}]}], "]"}], 
         ",", "\[IndentingNewLine]", "Red", ",", 
         RowBox[{"PointSize", "[", "0.02", "]"}], ",", 
         RowBox[{"Point", "[", 
