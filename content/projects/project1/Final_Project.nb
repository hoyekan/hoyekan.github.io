Cell[CellGroupData[{

Cell[TextData[StyleBox["Multiple Well Solution",
 FontWeight->"Bold",
 FontVariations->{"Underline"->True}]], "Subsubsection",
 CellChangeTimes->{{3.9541396825409403`*^9, 
  3.954139688476265*^9}},ExpressionUUID->"504ce2bc-c6e4-4f56-a693-\
ec9efbf81d68"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Two", " ", "wells", " ", "parameters"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Q1", "=", "30"}], ";"}], 
   RowBox[{"(*", 
    RowBox[{"m\.b3", "/", "s"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Q2", "=", "35"}], ";"}], 
   RowBox[{"(*", 
    RowBox[{"m\.b3", "/", "s"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"well1", "=", 
     RowBox[{"{", 
      RowBox[{"150", ",", "300"}], "}"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"location", " ", "of", " ", "the", " ", "first", " ", "well"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"well2", "=", 
     RowBox[{"{", 
      RowBox[{"350", ",", "100"}], "}"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"location", " ", "of", " ", "the", " ", "second", " ", "well"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"obsWell", "=", 
     RowBox[{"{", 
      RowBox[{"400", ",", "300"}], "}"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"An", " ", "observation", " ", "well"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"h0", "=", "80"}], ";"}], "    ", 
   RowBox[{"(*", 
    RowBox[{"Observed", " ", "head", " ", 
     RowBox[{"(", "m", ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"K", "=", "0.01"}], ";"}], 
   RowBox[{"(*", 
    RowBox[{"Hydraulic", " ", "conductivity", " ", 
     RowBox[{"(", 
      RowBox[{"m", "/", "s"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Distance", " ", "functions"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"r1", "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
     SqrtBox[
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"x", "-", 
          RowBox[{"well1", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "2"], "+", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"y", "-", 
          RowBox[{"well1", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "2"]}]]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"r2", "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
     SqrtBox[
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"x", "-", 
          RowBox[{"well2", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "2"], "+", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"y", "-", 
          RowBox[{"well2", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "2"]}]]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rObs", "=", 
     RowBox[{"r1", "[", 
      RowBox[{
       RowBox[{"obsWell", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{"obsWell", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Reference", " ", "potential", " ", "at", " ", "the", " ", "observed", 
     " ", "well"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Phi0", "=", 
     RowBox[{"0.5", " ", "K", " ", 
      SuperscriptBox["h0", "2"]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Superposed", " ", "potential", " ", "and", " ", "stream", " ", 
     "function"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"PhiTwoWells", "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        FractionBox["Q1", 
         RowBox[{"2", " ", "Pi"}]], ")"}], "*", 
       RowBox[{"Log", "[", 
        FractionBox[
         RowBox[{"r1", "[", 
          RowBox[{"x", ",", "y"}], "]"}], "rObs"], "]"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        FractionBox["Q2", 
         RowBox[{"2", " ", "Pi"}]], ")"}], "*", 
       RowBox[{"Log", "[", 
        FractionBox[
         RowBox[{"r2", "[", 
          RowBox[{"x", ",", "y"}], "]"}], "rObs"], "]"}]}], "+", "Phi0"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"PsiTwoWells", "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        FractionBox["Q1", 
         RowBox[{"2", " ", "Pi"}]], ")"}], "*", 
       RowBox[{"ArcTan", "[", 
        RowBox[{
         RowBox[{"x", "-", 
          RowBox[{"well1", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", 
         RowBox[{"y", "-", 
          RowBox[{"well1", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}]}], "+", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"(", 
        FractionBox["Q2", 
         RowBox[{"2", " ", "Pi"}]], ")"}], "*", 
       RowBox[{"ArcTan", "[", 
        RowBox[{
         RowBox[{"x", "-", 
          RowBox[{"well2", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", 
         RowBox[{"y", "-", 
          RowBox[{"well2", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}]}]}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9541397058715057`*^9, 3.9541397058742685`*^9}, {
   3.954232015610632*^9, 3.9542322547790546`*^9}, {3.954304471146201*^9, 
   3.9543045070013447`*^9}, {3.954304776828264*^9, 3.954304780166931*^9}, {
   3.9543048605055375`*^9, 3.9543048639023485`*^9}, {3.954305377835015*^9, 
   3.954305378539353*^9}, {3.95430689746976*^9, 3.9543069379486494`*^9}, {
   3.954311853032242*^9, 3.9543118554482203`*^9}, {3.9549831866395006`*^9, 
   3.9549831871907854`*^9}, 3.9549837302011166`*^9},
 CellLabel->"In[32]:=",ExpressionUUID->"e1c24719-8ad4-40ae-84ad-85ec8e91355f"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Uniform Flow with Wells",
 FontVariations->{"Underline"->True}]], "Subsubsection",
 CellChangeTimes->{{3.9541397160752077`*^9, 3.954139721632261*^9}},
 FontWeight->"Bold",ExpressionUUID->"0ddf48ca-e4e2-42a7-8fbe-cf441efc156c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Uniform", " ", "flow", " ", "parameters"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Quniform", "=", "0.04"}], ";"}], 
   RowBox[{"(*", 
    RowBox[{"m\.b2", "/", "s"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Combined", " ", "potential", " ", "and", " ", "stream", " ", 
     "function"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"PhiUniform", "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "Quniform"}], "*", "x"}], "+", 
      RowBox[{"PhiTwoWells", "[", 
       RowBox[{"x", ",", "y"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"PsiUniform", "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "Quniform"}], "*", "y"}], "+", 
      RowBox[{"PsiTwoWells", "[", 
       RowBox[{"x", ",", "y"}], "]"}]}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.954139735034852*^9, 3.954139735037855*^9}, {
   3.954232293377056*^9, 3.9542323082329273`*^9}, 3.954307292191325*^9},
 CellLabel->"In[45]:=",ExpressionUUID->"37fba848-2086-4f77-b15d-ada65d9322ea"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Flow Net Visualization",
 FontVariations->{"Underline"->True}]], "Subsubsection",
 CellChangeTimes->{{3.9541397373782396`*^9, 3.954139737905752*^9}, {
  3.95413980743278*^9, 3.9541398151481295`*^9}},
 FontWeight->"Bold",ExpressionUUID->"150af20c-486c-4e19-acec-d7d127719922"],

Cell[BoxData[
 RowBox[{
  RowBox[{"plotFlowNet", "[", 
   RowBox[{"phi_", ",", "psi_", ",", "range_", ",", "title_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Labeled", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Show", "[", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Plot", " ", "for", " ", "phi"}], " ", "-", "  ", 
         RowBox[{"discharge", " ", "potential"}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ContourPlot", "[", 
         RowBox[{
          RowBox[{"phi", "[", 
           RowBox[{"x", ",", "y"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", 
            RowBox[{"range", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"range", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"y", ",", 
            RowBox[{"range", "[", 
             RowBox[{"[", "3", "]"}], "]"}], ",", 
            RowBox[{"range", "[", 
             RowBox[{"[", "4", "]"}], "]"}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Contours", "\[Rule]", "20"}], ",", 
          RowBox[{"ContourShading", "\[Rule]", "None"}], ",", 
          RowBox[{"ContourStyle", "\[Rule]", "Blue"}]}], 
         RowBox[{"(*", 
          RowBox[{",", " ", 
           RowBox[{"ContourLabels", "\[Rule]", 
            RowBox[{"Function", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", 
              RowBox[{"Text", "[", 
               RowBox[{
                RowBox[{"NumberForm", "[", 
                 RowBox[{"z", ",", 
                  RowBox[{"{", 
                   RowBox[{"4", ",", "1"}], "}"}]}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"x", ",", "y"}], "}"}], ",", 
                RowBox[{"Background", "\[Rule]", "White"}]}], "]"}]}], 
             "]"}]}]}], "*)"}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Plot", " ", "for", " ", "psi"}], " ", "-", "  ", 
          RowBox[{"stream", " ", "potential"}]}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"ContourPlot", "[", 
         RowBox[{
          RowBox[{"psi", "[", 
           RowBox[{"x", ",", "y"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", 
            RowBox[{"range", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"range", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"y", ",", 
            RowBox[{"range", "[", 
             RowBox[{"[", "3", "]"}], "]"}], ",", 
            RowBox[{"range", "[", 
             RowBox[{"[", "4", "]"}], "]"}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Contours", "\[Rule]", "20"}], ",", 
          RowBox[{"ContourShading", "\[Rule]", "None"}], ",", 
          RowBox[{"ContourStyle", "\[Rule]", "Red"}]}], 
         RowBox[{"(*", 
