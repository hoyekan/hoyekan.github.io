Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Radial", " ", "Flow", " ", 
    RowBox[{"rate", ":", "\[IndentingNewLine]", "\t\t\t\t\t\t", 
     StyleBox[
      SubscriptBox["Q", "r"],
      FontColor->RGBColor[1., 0., 0.]]}]}], 
   StyleBox[" ",
    FontColor->RGBColor[1., 0., 0.]], 
   StyleBox["=",
    FontColor->RGBColor[1., 0., 0.]], 
   StyleBox[" ",
    FontColor->RGBColor[1., 0., 0.]], 
   StyleBox[
    RowBox[{
     FractionBox["Q", 
      RowBox[{"2", " ", "\[Pi]", " ", "r"}]], " ", "=", " ", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"d", " ", "\[CapitalPhi]"}], 
       RowBox[{"d", " ", "r"}]]}]}],
    FontColor->RGBColor[1., 0., 0.]]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
   "Integrating", " ", "with", " ", "boundary", " ", "condition", " ", 
    "\[CapitalPhi]", 
    RowBox[{"(", 
     SubscriptBox["r", "0"], ")"}]}], "=", " ", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[CapitalPhi]", "0"], " ", ":", 
     StyleBox["\[IndentingNewLine]",
      FontSize->5], "\[IndentingNewLine]", "\t\t\t\t\t\t", 
     StyleBox[
      RowBox[{"\[CapitalPhi]", 
       RowBox[{"(", "r", ")"}]}],
      FontColor->RGBColor[0.5019607843137255, 0.5019607843137255, 0.]]}], 
    StyleBox[" ",
     FontColor->RGBColor[0.5019607843137255, 0.5019607843137255, 0.]], 
    StyleBox["=",
     FontColor->RGBColor[0.5019607843137255, 0.5019607843137255, 0.]], 
    StyleBox[" ",
     FontColor->RGBColor[0.5019607843137255, 0.5019607843137255, 0.]], 
    StyleBox[
     RowBox[{
      RowBox[{
       FractionBox["Q", 
        RowBox[{"2", " ", "\[Pi]"}]], " ", "ln", " ", 
       RowBox[{"(", 
        FractionBox["r", 
         SubscriptBox["r", "0"]], ")"}]}], " ", "+", " ", 
      SubscriptBox["\[CapitalPhi]", "0"]}],
     FontColor->RGBColor[0.5019607843137255, 0.5019607843137255, 0.]]}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"To", " ", "form", " ", "flownet"}], ",", 
  RowBox[{
  "streamlines", " ", "should", " ", "be", " ", "drawn", " ", "which", " ", 
   "aslo", " ", "satisfies", " ", "the", " ", 
   RowBox[{"laplace", "'"}], "s", " ", 
   RowBox[{"equation", ".", " ", "Streamlines"}], " ", "are", " ", 
   "tangential", " ", "to", " ", "flow", " ", "vectors"}]}], "\n", 
 RowBox[{
  RowBox[{"and", " ", "intersect", " ", "the", " ", "equipotentials", " ", 
   RowBox[{"perpendicularly", ".", " ", "The"}], " ", "stream", " ", 
   "function", " ", "is"}], " "}], "\[IndentingNewLine]", 
 RowBox[{"\t\t\t\t\t\t\t", 
  RowBox[{
   StyleBox["\[Psi]",
    FontColor->RGBColor[0.5019607843137255, 0.5019607843137255, 0.]], 
   StyleBox[" ",
    FontColor->RGBColor[0.5019607843137255, 0.5019607843137255, 0.]], 
   StyleBox["=",
    FontColor->RGBColor[0.5019607843137255, 0.5019607843137255, 0.]], 
   StyleBox[" ",
    FontColor->RGBColor[0.5019607843137255, 0.5019607843137255, 0.]], 
   RowBox[{
    StyleBox[
     FractionBox["Q", 
      RowBox[{"2", " ", "\[Pi]"}]],
     FontColor->RGBColor[0.5019607843137255, 0.5019607843137255, 0.]], 
    StyleBox[" ",
     FontColor->RGBColor[0.5019607843137255, 0.5019607843137255, 0.]], 
    StyleBox[
     SuperscriptBox["tan", 
      RowBox[{"-", "1"}]],
