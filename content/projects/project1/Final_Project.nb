Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
   "Discharge", " ", "Potential", " ", "for", " ", "a", " ", "well", " ", 
    "in", " ", "polar", " ", 
    RowBox[{"coordinates", ":", "\[IndentingNewLine]", 
     RowBox[{"\[CapitalPhi]", 
      RowBox[{"(", "r", ")"}]}]}]}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     FractionBox["Q", 
      RowBox[{"2", " ", "\[CapitalPi]"}]], "ln", 
     RowBox[{"(", "r", ")"}]}], " ", "+", " ", "C"}]}], 
  " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Q", " ", "is", " ", "the", " ", "pumping", " ", "rate"}], ",", " ", 
  RowBox[{
  "r", " ", "is", " ", "the", " ", "radial", " ", "distance", " ", "from", 
   " ", "the", " ", "well"}], ",", 
  RowBox[{
  "and", " ", "C", " ", "is", " ", "a", " ", "constant", " ", "determined", 
   " ", "by", " ", "the", " ", "boundary", " ", 
   RowBox[{"conditions", "."}]}]}]}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
