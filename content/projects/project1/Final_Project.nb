Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Discharge", " ", "potential", " ", "of", " ", "the", " ", "transient", 
    " ", "flow", " ", "in", " ", "an", " ", "unconfined", " ", "aquifer"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"PhiTransientFlow", "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", " ", 
     RowBox[{"0.5", " ", "*", " ", "K", " ", "*", " ", 
      SuperscriptBox[
       RowBox[{"HeadTotal", "[", 
        RowBox[{"x", ",", "y", ",", "t"}], "]"}], "2"]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", "Visualization", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Show", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ContourPlot", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"PhiTransientFlow", "[", 
        RowBox[{"x", ",", "y"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "500"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", "0", ",", "500"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Contours", "\[Rule]", "20"}], ",", 
       RowBox[{"ContourShading", "->", "None"}], ",", 
       RowBox[{"ContourStyle", "->", "Red"}], "\[IndentingNewLine]", ",", 
       RowBox[{"ContourLabels", "->", 
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", 
          RowBox[{"Text", "[", 
           RowBox[{
            RowBox[{"NumberForm", "[", 
             RowBox[{"z", ",", 
              RowBox[{"{", 
               RowBox[{"4", ",", "1"}], "}"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "y"}], "}"}], ",", 
            RowBox[{"Background", "->", "White"}]}], "]"}]}], "]"}]}]}], 
      "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"Black", ",", 
        RowBox[{"PointSize", "[", "0.02", "]"}], ",", 
        RowBox[{"Point", "[", "well1", "]"}], ",", 
        RowBox[{"Point", "[", "well2", "]"}], ",", "\[IndentingNewLine]", 
