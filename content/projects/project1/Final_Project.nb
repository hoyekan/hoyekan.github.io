   RowBox[{"(*", 
    RowBox[{"Storativity", "[", "dimensionless", "]"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"b", "=", " ", "20"}], ";"}], "       ", 
   RowBox[{"(*", 
    RowBox[{"assuming", " ", "aquifer", " ", "thickness"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"T", "=", 
     RowBox[{"K", "*", "b"}]}], ";"}], "    ", 
   RowBox[{"(*", 
    RowBox[{"Transmissivity", "[", 
     RowBox[{"m\.b2", "/", "s"}], "]"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Q1", "=", "30"}], ";"}], "    ", 
   RowBox[{"(*", 
    RowBox[{"Discharge", " ", 
     RowBox[{"(", "pumping", ")"}], " ", 
     RowBox[{"rate", "[", 
      RowBox[{"m\.b3", "/", "s"}], "]"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Q2", "=", " ", "35"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"h0", " ", "=", " ", "80"}], ";"}], "  ", 
   RowBox[{"(*", 
    RowBox[{"assuming", " ", "initial", " ", "head"}], "*)"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Well", " ", "locations"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"well1", "=", 
     RowBox[{"{", 
      RowBox[{"150", ",", "300"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"well2", "=", 
     RowBox[{"{", 
      RowBox[{"350", ",", "100"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Well", " ", "function"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"W", "[", 
      RowBox[{"u_", ",", 
       RowBox[{"n_Integer", "?", "Positive"}]}], "]"}], ":=", " ", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"N", "[", 
        RowBox[{"EulerGamma", ",", "100"}], "]"}]}], "-", 
      RowBox[{"Log", "[", "u", "]"}], "+", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], 
          RowBox[{"k", "+", "1"}]], " ", 
         FractionBox[
          SuperscriptBox["u", "k"], 
          RowBox[{"k", " ", 
           RowBox[{"Factorial", "[", "k", "]"}]}]]}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Drawdown", " ", "due", " ", "to", " ", "Theis", " ", "equation"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"drawdown", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x_", ",", "y_"}], "}"}], ",", "t_"}], "]"}], ":=", 
    "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r1", ",", "r2", ",", "u1", ",", "u2", ",", "s1", ",", "s2"}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"r1", "=", 
        SqrtBox[
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"x", "-", 
             RowBox[{"well1", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "2"], "+", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"y", "-", 
             RowBox[{"well1", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "2"]}]]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"r2", "=", 
        SqrtBox[
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"x", "-", 
             RowBox[{"well2", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "2"], "+", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"y", "-", 
             RowBox[{"well2", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "2"]}]]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"u1", "=", 
        FractionBox[
         RowBox[{
          SuperscriptBox["r1", "2"], " ", "S"}], 
         RowBox[{"4", " ", "T", " ", "t"}]]}], ";", "\[IndentingNewLine]", 
       RowBox[{"u2", "=", 
        FractionBox[
         RowBox[{
          SuperscriptBox["r2", "2"], " ", "S"}], 
         RowBox[{"4", " ", "T", " ", "t"}]]}], ";", "\[IndentingNewLine]", 
       RowBox[{"s1", "=", 
        RowBox[{
         RowBox[{"(", 
          FractionBox["Q1", 
           RowBox[{"4", " ", "Pi", " ", "T"}]], ")"}], " ", 
         RowBox[{"W", "[", 
          RowBox[{"u1", ",", "100"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"s2", "=", 
        RowBox[{
         RowBox[{"(", 
          FractionBox["Q2", 
           RowBox[{"4", " ", "Pi", " ", "T"}]], ")"}], " ", 
         RowBox[{"W", "[", 
          RowBox[{"u2", ",", "100"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"s1", "+", "s2"}]}]}], "\[IndentingNewLine]", "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"t", "=", "3600"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Calculating", " ", "head", " ", "due", " ", "to", " ", "both", " ", 
     "wells"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"HeadTotal", "[", 
      RowBox[{"x_", ",", "y_", ",", "t_"}], "]"}], ":=", 
     RowBox[{"h0", "-", 
      RowBox[{"drawdown", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "y"}], "}"}], ",", "t"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "3", "D", " ", "surface", " ", "plot", " ", "of", " ", "head", " ", "at",
       " ", "t"}], " ", "=", " ", "3600"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Plot3D", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"HeadTotal", "[", 
      RowBox[{"x", ",", "y", ",", "t"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "500"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", "0", ",", "500"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{
       "\"\<x (m)\>\"", ",", "\"\<y (m)\>\"", ",", "\"\<Head (m)\>\""}], 
       "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"PlotLabel", "\[Rule]", 
      RowBox[{"Style", "[", 
       RowBox[{
       "\"\<2-Well Theis Head Surface at t = 1 hr\>\"", ",", "12", ",", 
        "Bold"}], "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"ImageSize", "->", "Medium"}], ",", 
     RowBox[{"PlotPoints", "->", "70"}], ",", 
     RowBox[{"ColorFunction", "->", "\"\<Rainbow\>\""}], ",", 
     RowBox[{"Boxed", "->", "True"}], ",", 
     RowBox[{"PlotLegends", "\[Rule]", "Automatic"}]}], "\[IndentingNewLine]",
     "]"}]}]}]], "Input",
