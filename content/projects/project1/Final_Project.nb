       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "500"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", "0", ",", "500"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Contours", "->", "20"}], ",", 
       RowBox[{"ContourShading", "->", "None"}], ",", 
       RowBox[{"ContourStyle", "->", "Red"}]}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
