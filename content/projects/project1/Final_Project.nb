  3.954231684953764*^9, 3.9542317287916193`*^9}},
 FontSize->12,
 FontWeight->"Bold",
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"b6aee861-4225-42fa-a98a-1b71d4d0f02c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Q1", "=", "15"}], ";"}], "                       ", 
  RowBox[{"(*", 
   RowBox[{"Pumping", " ", "rate", " ", 
    RowBox[{"(", 
     RowBox[{"m\.b3", "/", "s"}], ")"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"well", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{"100", ",", "250"}], "}"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Pumping", " ", "well", " ", "location"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"r0", "=", "10"}], ";"}], "     ", 
  RowBox[{"(*", 
   RowBox[{"Reference", " ", "distance", " ", 
    RowBox[{"(", "m", ")"}], " ", 
    RowBox[{"(", 
     RowBox[{"if", " ", "not", " ", "using", " ", "obWell"}], ")"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Phi0", "=", "32"}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"Reference", " ", "potential"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"K", "=", "0.01"}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"Hydraulic", " ", "conductivity", " ", 
    RowBox[{"(", 
     RowBox[{"m", "/", "s"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Distance", " ", "and", " ", "angle", " ", "from", " ", "well", " ", "to", 
    " ", "any", " ", 
    RowBox[{"(", 
     RowBox[{"x", ",", "y"}], ")"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rr", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   SqrtBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"x", "-", 
        RowBox[{"well", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "2"], "+", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"y", "-", 
        RowBox[{"well", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "2"]}]]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"thetaa", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], " ", "=", " ", 
    RowBox[{"ArcTan", "[", 
     RowBox[{
      RowBox[{"x", "-", 
       RowBox[{"well", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", 
      RowBox[{"y", "-", 
       RowBox[{"well", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Discharge", " ", "potential", " ", "and", " ", "stream", " ", 
    "function"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PhiWell", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      FractionBox["Q1", 
       RowBox[{"2", " ", "Pi"}]], ")"}], "*", 
     RowBox[{"Log", "[", 
      FractionBox[
       RowBox[{"rr", "[", 
        RowBox[{"x", ",", "y"}], "]"}], "r0"], "]"}]}], "+", "Phi0"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"PsiWell", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     FractionBox["Q1", 
      RowBox[{"2", " ", "Pi"}]], ")"}], "*", 
    RowBox[{"thetaa", "[", 
     RowBox[{"x", ",", "y"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
