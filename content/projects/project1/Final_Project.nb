Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "well", " ", "positions", " ", "dynamically"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"well1", "=", 
      RowBox[{"{", 
       RowBox[{"x1", ",", "y1"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"well2", "=", 
      RowBox[{"{", 
       RowBox[{"x2", ",", "y2"}], "}"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Reference", " ", "distances", " ", "from", " ", "a", " ", "fixed", " ",
        "observation", " ", "point"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"obsWell", "=", 
      RowBox[{"{", 
       RowBox[{"400", ",", "300"}], "}"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Heterogeneity", ":", 
       RowBox[{
       "function", " ", "for", " ", "spatially", " ", "varying", " ", "K"}]}],
       "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"KxFunc", "[", 
       RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
      RowBox[{"0.01", "+", 
       RowBox[{"0.005", " ", 
        RowBox[{"Sin", "[", 
         RowBox[{
          RowBox[{"0.01", " ", "x"}], "+", 
          RowBox[{"0.02", " ", "y"}]}], "]"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"KyFunc", "[", 
       RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
      RowBox[{"0.01", "+", 
       RowBox[{"0.003", " ", 
        RowBox[{"Cos", "[", 
         RowBox[{
          RowBox[{"0.015", " ", "x"}], "-", 
          RowBox[{"0.01", " ", "y"}]}], "]"}]}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"r1Aniso", "[", 
       RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
      SqrtBox[
       RowBox[{
        FractionBox[
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"x", "-", 
            RowBox[{"well1", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "2"], 
         RowBox[{"KxFunc", "[", 
          RowBox[{"x", ",", "y"}], "]"}]], " ", "+", " ", 
        FractionBox[
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"y", "-", 
            RowBox[{"well1", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "2"], 
         RowBox[{"KyFunc", "[", 
          RowBox[{"x", ",", "y"}], "]"}]]}]]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"r2Aniso", "[", 
       RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
      SqrtBox[
       RowBox[{
        FractionBox[
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"x", "-", 
            RowBox[{"well2", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "2"], 
         RowBox[{"KxFunc", "[", 
          RowBox[{"x", ",", "y"}], "]"}]], " ", "+", " ", 
        FractionBox[
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"y", "-", 
            RowBox[{"well2", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "2"], 
         RowBox[{"KyFunc", "[", 
          RowBox[{"x", ",", "y"}], "]"}]]}]]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"r1ObsAniso", "=", 
      RowBox[{"r1Aniso", "@@", "obsWell"}]}], ";", "\n", 
     RowBox[{"r2ObsAniso", "=", 
      RowBox[{"r2Aniso", "@@", "obsWell"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Keff", "[", 
       RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
      SqrtBox[
       RowBox[{
        RowBox[{"KxFunc", "[", 
         RowBox[{"x", ",", "y"}], "]"}], "*", " ", 
        RowBox[{"KyFunc", "[", 
         RowBox[{"x", ",", "y"}], "]"}]}]]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Discharge", " ", "potential", " ", "at", " ", "observation", " ", 
       "well"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Phi0", "=", 
      RowBox[{"0.5", " ", 
       RowBox[{"Keff", "@@", "obsWell"}], " ", 
       SuperscriptBox["h0", "2"]}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Discharge", " ", "potential", " ", "function"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"PhiInteractive", "[", 
       RowBox[{"x_", ",", "y_"}], "]"}], ":=", "\[IndentingNewLine]", 
