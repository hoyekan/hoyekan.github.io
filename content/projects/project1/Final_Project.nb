       RowBox[{"PlotLabel", "\[Rule]", 
        RowBox[{"Style", "[", 
         RowBox[{
         "\"\<Head Distribution at t = 1 hr\>\"", ",", "12", ",", "Bold"}], 
         "]"}]}], ",", 
       RowBox[{"ColorFunction", "\[Rule]", "\"\<Rainbow\>\""}], ",", 
       RowBox[{"Contours", "->", "20"}], ",", 
       RowBox[{"ContourLabels", "->", "Automatic"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Interpolate", " ", "headValues", " ", "for", " ", "gradient", " ", 
     "calculation"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"hInterpolated", "=", 
     RowBox[{"ListInterpolation", "[", 
      RowBox[{"headValues", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "500"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "500"}], "}"}]}], "}"}]}], "]"}]}], ";"}], 
