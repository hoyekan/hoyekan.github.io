    StyleBox[
     RowBox[{"(", 
      FractionBox["y", "x"], ")"}],
     FontColor->RGBColor[0.5019607843137255, 0.5019607843137255, 0.]], " ", 
    RowBox[{"(", 
     RowBox[{"in", " ", "Cartesian", " ", "coordinate"}], 
     ")"}]}]}]}]}], "Text",
