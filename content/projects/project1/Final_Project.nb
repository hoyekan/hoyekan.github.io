Cell[CellGroupData[{

Cell["\<\
Modelling  Steady Groundwater  Flow around pumping wells  in an Heterogeneous \
and Anisotropic unconfined aquifer using discharge potential .\
\>", "Title",
 CellChangeTimes->{{3.955185756686168*^9, 3.9551858607961903`*^9}, {
  3.9551859128076735`*^9, 3.955185965241933*^9}},
 FontSize->23,
 FontWeight->"Bold",
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"be6e28e9-9b2a-4557-aa36-0daacf6795f1"],

Cell[BoxData[
 RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.95413939991811*^9, 3.9541394054295635`*^9}},
 CellLabel->"In[61]:=",ExpressionUUID->"0c887d9f-88c9-4fe3-9e0f-3c4efa971e44"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Two", " ", "wells", " ", "parameters"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Q1", "=", "30"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"m\.b3", "/", "s"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Q2", "=", "35"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"m\.b3", "/", "s"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"well1", "=", 
     RowBox[{"{", 
      RowBox[{"150", ",", "300"}], "}"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"location", " ", "of", " ", "the", " ", "first", " ", "well"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"well2", "=", 
     RowBox[{"{", 
      RowBox[{"350", ",", "100"}], "}"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"location", " ", "of", " ", "the", " ", "second", " ", "well"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"obsWell", "=", 
     RowBox[{"{", 
      RowBox[{"400", ",", "300"}], "}"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"An", " ", "observation", " ", "well"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"h0", "=", "80"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Observed", " ", "head", " ", 
     RowBox[{"(", "m", ")"}]}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Anisotropic", " ", "hydraulic", " ", "conductivities", " ", 
     RowBox[{"(", 
      RowBox[{"Kx", "\[NotEqual]", "Ky"}], ")"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"KxFunc", "[", 
       RowBox[{"x_", ",", "y_"}], "]"}], ":=", "0.01"}], ";", " ", 
     RowBox[{"(*", 
      RowBox[{"Spatially", " ", "varying", " ", "Kx"}], "*)"}], "\n", 
     RowBox[{
      RowBox[{"KyFunc", "[", 
       RowBox[{"x_", ",", "y_"}], "]"}], ":=", "0.005"}], ";"}], " ", 
    RowBox[{"(*", 
     RowBox[{"Spatially", " ", "varying", " ", "Ky"}], "*)"}], 
    "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Heterogeneity", ":", 
     RowBox[{
     "function", " ", "for", " ", "spatially", " ", "varying", " ", "K"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"KxFunc", "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
     RowBox[{"0.01", "+", 
      RowBox[{"0.005", " ", 
       RowBox[{"Sin", "[", 
        RowBox[{
         RowBox[{"0.01", " ", "x"}], "+", 
         RowBox[{"0.02", " ", "y"}]}], "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"KyFunc", "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
     RowBox[{"0.01", "+", 
      RowBox[{"0.003", " ", 
       RowBox[{"Cos", "[", 
        RowBox[{
         RowBox[{"0.015", " ", "x"}], "-", 
         RowBox[{"0.01", " ", "y"}]}], "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Effective", " ", "conductivity", " ", "for", " ", "potential"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Keff", "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
     SqrtBox[
      RowBox[{
       RowBox[{"KxFunc", "[", 
        RowBox[{"x", ",", "y"}], "]"}], "*", " ", 
       RowBox[{"KyFunc", "[", 
        RowBox[{"x", ",", "y"}], "]"}]}]]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{"Transformed", " ", "distances", " ", "for", " ", "anisotropy"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"r1Aniso", "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
     SqrtBox[
      RowBox[{
       FractionBox[
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"x", "-", 
           RowBox[{"well1", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "2"], 
        RowBox[{"KxFunc", "[", 
         RowBox[{"x", ",", "y"}], "]"}]], " ", "+", " ", 
       FractionBox[
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"y", "-", 
           RowBox[{"well1", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "2"], 
        RowBox[{"KyFunc", "[", 
         RowBox[{"x", ",", "y"}], "]"}]]}]]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"r2Aniso", "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", " ", 
     SqrtBox[
      RowBox[{
       FractionBox[
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"x", "-", 
           RowBox[{"well2", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "2"], 
        RowBox[{"KxFunc", "[", 
         RowBox[{"x", ",", "y"}], "]"}]], " ", "+", " ", 
       FractionBox[
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"y", "-", 
           RowBox[{"well2", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "2"], 
        RowBox[{"KyFunc", "[", 
         RowBox[{"x", ",", "y"}], "]"}]]}]]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"r1ObsAniso", "=", 
     RowBox[{"r1Aniso", "@@", "obsWell"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"r2ObsAniso", "=", 
     RowBox[{"r2Aniso", "@@", "obsWell"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Reference", " ", "potential", " ", "at", " ", "the", " ", "observed", 
     " ", "well"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Phi0", "=", 
     RowBox[{"0.5", "*", 
      RowBox[{"Keff", "@@", "obsWell"}], "*", 
      SuperscriptBox["h0", "2"]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Superposed", " ", "potential", " ", "and", " ", "stream", " ", 
     "function"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"PhiTwoWells", "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        FractionBox["Q1", 
         RowBox[{"2", " ", "Pi"}]], " ", 
        RowBox[{"Log", "[", 
         FractionBox[
          RowBox[{"r1Aniso", "[", 
           RowBox[{"x", ",", "y"}], "]"}], "r1ObsAniso"], "]"}]}], ")"}], " ",
       "+", " ", 
      RowBox[{"(", 
       RowBox[{
        FractionBox["Q2", 
         RowBox[{"2", " ", "Pi"}]], " ", 
        RowBox[{"Log", "[", 
         FractionBox[
          RowBox[{"r2Aniso", "[", 
           RowBox[{"x", ",", "y"}], "]"}], "r2ObsAniso"], "]"}]}], ")"}], " ",
       "+", "Phi0"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Stream", " ", "function", " ", "approximation", " ", "for", " ", 
     "anisotropy"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"PsiTwoWells", "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       FractionBox["Q1", 
        RowBox[{"2", " ", "Pi"}]], " ", 
       RowBox[{"ArcTan", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"x", "-", 
            RowBox[{"well1", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ")"}], " ", 
          SqrtBox[
           FractionBox[
            RowBox[{"KyFunc", "[", 
             RowBox[{"x", ",", "y"}], "]"}], 
            RowBox[{"KxFunc", "[", 
             RowBox[{"x", ",", "y"}], "]"}]]]}], " ", ",", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"y", "-", 
            RowBox[{"well1", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ")"}], " ", 
          SqrtBox[
           FractionBox[
            RowBox[{"KxFunc", "[", 
             RowBox[{"x", ",", "y"}], "]"}], 
            RowBox[{"KyFunc", "[", 
             RowBox[{"x", ",", "y"}], "]"}]]]}]}], "]"}]}], "   ", "+", " ", 
      RowBox[{
       FractionBox["Q2", 
        RowBox[{"2", " ", "Pi"}]], " ", 
       RowBox[{"ArcTan", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"x", "-", 
            RowBox[{"well2", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ")"}], " ", 
          SqrtBox[
           FractionBox[
            RowBox[{"KyFunc", "[", 
             RowBox[{"x", ",", "y"}], "]"}], 
            RowBox[{"KxFunc", "[", 
             RowBox[{"x", ",", "y"}], "]"}]]]}], " ", ",", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"y", "-", 
            RowBox[{"well2", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ")"}], " ", 
          SqrtBox[
           FractionBox[
            RowBox[{"KxFunc", "[", 
             RowBox[{"x", ",", "y"}], "]"}], 
            RowBox[{"KyFunc", "[", 
             RowBox[{"x", ",", "y"}], "]"}]]]}]}], "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", "Visualization", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Show", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ContourPlot", "[", "\[IndentingNewLine]", 
