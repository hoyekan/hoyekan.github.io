          RowBox[{"well1", "+", 
           RowBox[{"{", 
            RowBox[{"10", ",", "10"}], "}"}]}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Text", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"\"\<Well 2\>\"", ",", "8", ",", "Bold"}], "]"}], ",", 
          RowBox[{"well2", "+", 
           RowBox[{"{", 
            RowBox[{"10", ",", "10"}], "}"}]}]}], "]"}]}], "}"}], 
      "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"Axes", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
