       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "500"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", "0", ",", "500"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Contours", "->", "20"}], ",", 
       RowBox[{"ContourShading", "->", "None"}], ",", 
       RowBox[{"ContourStyle", "->", "Blue"}]}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{",", 
        RowBox[{"ContourLabels", "->", 
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", 
           RowBox[{"Text", "[", 
            RowBox[{
             RowBox[{"NumberForm", "[", 
              RowBox[{"z", ",", 
               RowBox[{"{", 
                RowBox[{"4", ",", "1"}], "}"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "y"}], "}"}], ",", 
             RowBox[{"Background", "->", "White"}]}], "]"}]}], "]"}]}]}], 
       "*)"}], "]"}], ",", 
     RowBox[{"Graphics", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"Black", ",", 
        RowBox[{"PointSize", "[", "0.02", "]"}], ",", 
        RowBox[{"Point", "[", "well1", "]"}], ",", 
        RowBox[{"Point", "[", "well2", "]"}], ",", 
        RowBox[{"Text", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"\"\<Well 1\>\"", ",", "8", ",", "Bold"}], "]"}], ",", 
          RowBox[{"well1", "+", 
           RowBox[{"{", 
            RowBox[{"10", ",", "10"}], "}"}]}]}], "]"}], ",", 
        RowBox[{"Text", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"\"\<Well 2\>\"", ",", "8", ",", "Bold"}], "]"}], ",", 
          RowBox[{"well2", "+", 
           RowBox[{"{", 
            RowBox[{"10", ",", "10"}], "}"}]}]}], "]"}]}], "}"}], 
      "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"Axes", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<x (m)\>\"", ",", "\"\<y (m)\>\""}], "}"}]}], ",", 
     RowBox[{"GridLines", "->", "Automatic"}], ",", 
     RowBox[{"PlotLabel", "->", 
      RowBox[{"Style", "[", 
       RowBox[{
       "\"\<Flow Net: Discharge and Stream Functions\>\"", ",", "12", ",", 
        "Bold"}], "]"}]}]}], "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "##", "##", "##", "##", "##", "##", "##", "##", "##", "##", "##", "##", 
     "##", "##", "##", "##", "##", "##", "##", "##", "##", "##", "##", "##", 
     "##", "##", "##", "#"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Convert", " ", "potential", " ", "to", " ", "head"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"HeadTwoWells", "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
     SqrtBox[
      FractionBox[
       RowBox[{"2", " ", 
        RowBox[{"PhiTwoWells", "[", 
         RowBox[{"x", ",", "y"}], "]"}]}], 
       RowBox[{"Keff", "[", 
        RowBox[{"x", ",", "y"}], "]"}]]]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Enhanced", " ", "contour", " ", "plotting", " ", "with", " ", "values"}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"PlotHead", "[", 
     RowBox[{"func_", ",", "range_", ",", "title_", ",", "ncontours_"}], 
     "]"}], ":=", "\[IndentingNewLine]", 
    RowBox[{"ContourPlot", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"func", "[", 
       RowBox[{"x", ",", "y"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"range", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{"range", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"y", ",", 
        RowBox[{"range", "[", 
         RowBox[{"[", "3", "]"}], "]"}], ",", 
        RowBox[{"range", "[", 
         RowBox[{"[", "4", "]"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Contours", "->", "ncontours"}], ",", 
      RowBox[{"ContourStyle", "\[Rule]", "Red"}], ",", 
      RowBox[{"ContourShading", "->", "None"}], ",", 
      RowBox[{"PlotLabel", "->", 
       RowBox[{"Style", "[", 
        RowBox[{"title", ",", "12", ",", "Bold"}], "]"}]}], ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<x (m)\>\"", ",", "\"\<y (m)\>\""}], "}"}]}], ",", 
      RowBox[{"ContourLabels", "->", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{
           RowBox[{"NumberForm", "[", 
            RowBox[{"z", ",", 
             RowBox[{"{", 
              RowBox[{"4", ",", "1"}], "}"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "y"}], "}"}], ",", 
           RowBox[{"Background", "->", "White"}]}], "]"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Epilog", "->", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{"Black", ",", 
         RowBox[{"PointSize", "[", "0.02", "]"}], ",", 
         RowBox[{"Point", "[", "well1", "]"}], ",", 
         RowBox[{"Point", "[", "well2", "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Text", "[", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{"\"\<Well 1\>\"", ",", "8", ",", "Bold"}], "]"}], ",", 
           RowBox[{"well1", "+", 
            RowBox[{"{", 
             RowBox[{"10", ",", "10"}], "}"}]}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Text", "[", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{"\"\<Well 2\>\"", ",", "8", ",", "Bold"}], "]"}], ",", 
           RowBox[{"well2", "+", 
            RowBox[{"{", 
             RowBox[{"10", ",", "10"}], "}"}]}]}], "]"}]}], "}"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"PlotRangePadding", "->", 
       RowBox[{"Scaled", "[", "0.05", "]"}]}], ",", 
      RowBox[{"ImageSize", "->", "Medium"}]}], " ", "\n", "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"PlotHead", "[", 
    RowBox[{"HeadTwoWells", ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "500", ",", "0", ",", "500"}], "}"}], ",", 
     "\"\<Hydraulic Head (h)\>\"", ",", "20"}], "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Needs", "[", "\"\<VectorFieldPlots`\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Head", " ", "Values"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"headValues", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"HeadTwoWells", "[", 
        RowBox[{"x", ",", "y"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "500", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", "0", ",", "500", ",", "1"}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Contour", " ", "plot", " ", "of", " ", "head"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"headcontourplot", " ", "=", " ", "\[IndentingNewLine]", 
     RowBox[{"ListContourPlot", "[", "\[IndentingNewLine]", 
      RowBox[{"headValues", ",", 
       RowBox[{"DataRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "500"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "500"}], "}"}]}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"PlotLegends", "->", "Automatic"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<x (m)\>\"", ",", "\"\<y (m)\>\""}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"PlotLabel", "->", "\"\<Head Distribution\>\""}], ",", 
       RowBox[{"ColorFunction", "\[Rule]", "\"\<Rainbow\>\""}], ",", 
       RowBox[{"Contours", "->", "20"}], ",", 
       RowBox[{"ContourLabels", "->", "Automatic"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Interpolate", " ", "headValues", " ", "for", " ", "gradient", " ", 
     "calculation"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"hInterpolated", "=", 
     RowBox[{"ListInterpolation", "[", 
      RowBox[{"headValues", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "500"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "500"}], "}"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Gradient", " ", "plot"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vectorplot", "=", 
     RowBox[{"GradientFieldPlot", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"hInterpolated", "[", 
         RowBox[{"x", ",", "y"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "500"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", "0", ",", "500"}], "}"}], ",", 
       RowBox[{"PlotPoints", "\[Rule]", "15"}], ",", 
       RowBox[{"ScaleFactor", "\[Rule]", "3"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Overlay", " ", "with", " ", "contour", " ", "plot"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{"headcontourplot", ",", "vectorplot", ",", 
     RowBox[{"Frame", "\[Rule]", " ", "False"}], ",", 
     RowBox[{"AspectRatio", "\[Rule]", 
      RowBox[{"22", "/", "20."}]}]}], "]"}], " ", 
   "\[IndentingNewLine]"}]}]], "Input",
