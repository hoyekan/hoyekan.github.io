   3.955362771451022*^9}, {3.955362988432582*^9, 3.9553630215211463`*^9}, {
   3.955363052257015*^9, 3.9553630862418375`*^9}, {3.9553631487192383`*^9, 
   3.9553632142187586`*^9}, {3.9553632512878838`*^9, 3.95536329830665*^9}, {
